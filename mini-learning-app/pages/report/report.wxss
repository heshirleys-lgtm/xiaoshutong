/* pages/report/report.wxss */
.wrap { padding-bottom: 20rpx; }
.head { display: flex; align-items: center; gap: 24rpx; }
.overall { font-size: 72rpx; font-weight: 800; color: #2f7cf6; min-width: 120rpx; text-align: center; }
.radar { width: 100%; height: 460rpx; }
.dim { margin: 18rpx 0; }
.dim-top { display: flex; justify-content: space-between; align-items: baseline; }
.dn { font-weight: 600; font-size: 28rpx; }
.badge { font-size: 22rpx; color: #fff; padding: 2rpx 16rpx; border-radius: 20rpx; }
.lv-优秀 { background: #1aab6b; } .lv-良好 { background: #e8923a; } .lv-待提升 { background: #e0524a; }
.bar { height: 16rpx; background: #eef1f6; border-radius: 8rpx; margin-top: 10rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; }
.fill-good { background: #1aab6b; } .fill-warn { background: #e8923a; } .fill-bad { background: #e0524a; }
.insight { font-size: 24rpx; color: #6b7785; margin-top: 8rpx; line-height: 1.55; }
.sugg { background: #fbfdff; border: 1rpx dashed #e6ebf2; border-radius: 12rpx; padding: 18rpx 22rpx; }
.sugg-item { font-size: 25rpx; line-height: 1.8; color: #44505e; }
