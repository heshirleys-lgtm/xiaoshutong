/* pages/profile/profile.wxss */
.wrap { padding-bottom: 20rpx; }
.head { display: flex; align-items: center; }
.dim { margin: 20rpx 0; }
.dn { font-weight: 600; font-size: 28rpx; }
.trend { display: flex; align-items: flex-end; gap: 10rpx; height: 120rpx; margin-top: 10rpx; padding-left: 8rpx; }
.tcell { width: 36rpx; display: flex; align-items: flex-end; height: 100%; }
.tbar { width: 100%; border-radius: 6rpx 6rpx 0 0; min-height: 6rpx; }
.fill-good { background: #1aab6b; } .fill-warn { background: #e8923a; } .fill-bad { background: #e0524a; }
