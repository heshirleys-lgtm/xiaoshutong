/* app.wxss 全局样式 */
page { background: #f5f7fb; font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif; color: #1f2733; }
.btn-primary { background: #2f7cf6; color: #fff; border-radius: 24rpx; font-weight: 600; }
.btn-ghost { background: #eef3fb; color: #2f7cf6; border-radius: 24rpx; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin: 24rpx; box-shadow: 0 2rpx 8rpx rgba(20,40,80,.05); }
.muted { color: #6b7785; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 700; }
.step-bar { display: flex; justify-content: space-between; padding: 20rpx 40rpx; }
.step-dot { flex: 1; text-align: center; font-size: 22rpx; color: #9aa6b2; }
.step-dot .dot { width: 40rpx; height: 40rpx; line-height: 40rpx; border-radius: 50%; background: #e0e6ee; color: #fff; margin: 0 auto 8rpx; font-size: 24rpx; }
.step-dot.active .dot { background: #2f7cf6; }
.step-dot.active { color: #2f7cf6; }
